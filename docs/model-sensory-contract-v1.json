{
  "schemaVersion": "1.1.0",
  "contractId": "LEEWAY_MODEL_SENSORY_CONTRACT_V1",
  "authority": "4citeB4U/LeeWay-Agent-Skills",
  "implementationRepo": "4citeB4U/Leeway-live",
  "serviceDependencies": {
    "paidThirdPartyRealtimeService": false,
    "thirdPartyRealtimeApiKey": false,
    "proprietaryHostedMediaAuthority": false
  },
  "transport": {
    "mediaPreferred": "NATIVE_WEBRTC_RTP_SRTP",
    "signalingPreferred": "LEEWAY_OWNED_WEBSOCKET_CONTROL",
    "natTraversal": [
      "DIRECT",
      "SELF_HOSTED_STUN_TURN_WHEN_REQUIRED"
    ],
    "media": [
      "audio",
      "video",
      "screen_share"
    ],
    "control": [
      "session",
      "sdp",
      "ice_candidate",
      "capability",
      "cancel",
      "epoch",
      "telemetry",
      "receipt_ref"
    ],
    "rule": "Transport is replaceable; LeeWay sensory semantics remain authoritative."
  },
  "agentSkillsAuthority": [
    "config/universal-voice-bus-v1.json",
    "config/realtime-voice-execution-contract-v1.json",
    "config/realtime-voice-multimodal-profile-v1.json",
    "config/realtime-voice-heavy-use-routing-v1.json",
    "skills/leeway-frontier-voice-architecture-selector/SKILL.md",
    "skills/leeway-real-time-voice-multimodal-infrastructure/SKILL.md"
  ],
  "requiredAdapterIdentity": [
    "adapterId",
    "adapterVersion",
    "provider",
    "model",
    "runtime",
    "executionLocation"
  ],
  "capabilityNegotiation": {
    "required": [
      "inputCapabilities",
      "outputCapabilities",
      "cancelSemantics",
      "timingSemantics",
      "providerModelIdentity"
    ],
    "rule": "Never assume an optional representation exists."
  },
  "modelClasses": {
    "nativeRealtime": {
      "consumes": [
        "native_audio_stream",
        "optional_live_video",
        "optional_text"
      ],
      "produces": [
        "native_audio_stream",
        "optional_text",
        "optional_semantic_events"
      ]
    },
    "cascadedText": {
      "consumes": [
        "stable_text",
        "optional_vision_semantics"
      ],
      "produces": [
        "text_delta"
      ],
      "harnessProvides": [
        "vad",
        "streaming_stt",
        "streaming_tts",
        "vision_adapter",
        "barge_in",
        "playout_ledger"
      ]
    },
    "localModel": {
      "transportToModel": "ADAPTER_DEFINED_LOCAL_OR_LAN",
      "examples": [
        "LiteRT",
        "Ollama",
        "llama.cpp",
        "OpenAI-compatible local endpoint"
      ],
      "mediaContract": "UNCHANGED"
    }
  },
  "universalVoiceBus": {
    "protocolId": "LEEWAY_UNIVERSAL_VOICE_BUS_V1",
    "requiredEnvelope": [
      "sessionId",
      "eventId",
      "eventType",
      "monotonicTimestamp",
      "generationEpoch",
      "source",
      "provenance"
    ]
  },
  "stateMachine": [
    "CONNECTING",
    "CONNECTED",
    "LISTENING",
    "USER_SPEAKING",
    "ENDPOINT_PENDING",
    "AGENT_THINKING",
    "AGENT_SPEAKING",
    "INTERRUPTING",
    "RECOVERING",
    "DEGRADED",
    "CLOSED"
  ],
  "hardGates": [
    "no_uncancellable_playout",
    "no_unbounded_audio_queue",
    "no_stale_epoch_output_after_interrupt",
    "no_silent_provider_fallback_without_evidence",
    "no_privacy_or_authority_violation",
    "no_false_modality_claim"
  ],
  "formulaPolicy": "./formula-sensory-policy-v1.json",
  "deviceLaw": "Device adapters publish capabilities/media and contain no model-specific sensory logic.",
  "modelLaw": "Model adapters consume the LeeWay session and contain no device-specific media logic.",
  "executionLaw": "Configured != executed; streaming != low latency; transport connected != healthy; audio generated != audio heard."
}
