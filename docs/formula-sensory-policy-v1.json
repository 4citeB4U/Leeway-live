  "sourceMath": {
    "audioFrameGeometry": {
      "expression": "N = Fs * dt_frame",
      "bytesExpression": "bytes = N * (B/8) * C",
      "class": "DOMAIN_CONSTRAINED_IDENTITY"
    },
    "responseCriticalPath": {
      "expression": "T_response_onset = critical_path(network, endpointing, STT, LLM_TTFT, chunker_dwell, TTS_TTFB, playout)",
      "class": "PHYSICAL_ENGINEERING_MODEL"
    },
    "synthesisRealtimeFactor": {
      "expression": "RTF = synth_wall_time / rendered_audio_duration",
      "class": "DOMAIN_CONSTRAINED_IDENTITY"
    },
    "queueLittle": {
      "expression": "L = lambda * W",
      "class": "STATISTICAL_MODEL",
      "domain": "stable average queue regime only"
    },
    "queueSaturation": {
      "expression": "rho_Q = lambda / mu",
      "class": "EXTERNAL_INFERENCE_METRIC"
    },
    "vadEnergy": {
      "expression": "STE = sum_n w[n] * x[n]^2",
      "class": "PHYSICAL_ENGINEERING_MODEL"
    },
    "vadRms": {
      "expression": "RMS = sqrt((1/N) * sum x[n]^2)",
      "dbfs": "dBFS = 20 * log10(RMS/xmax)",
      "class": "PHYSICAL_ENGINEERING_MODEL"
    },
    "bargeInSpill": {
      "expression": "T_spill ~= detection + local_flush + already_uninterruptible_device_path",
      "class": "PHYSICAL_ENGINEERING_MODEL"
    },
    "chunkMargin": {
      "expression": "M_i = audio_duration_i - synth_wall_time_i",
      "class": "PHYSICAL_ENGINEERING_MODEL"
    },
    "visionSampling": {
      "expression": "sample if semantic_change_score >= theta or task_trigger",
      "class": "HEURISTIC"
    },
    "q69": {
      "expression": "Q69(rho)=clamp(round(69*rho),0,69)",
      "reconstruction": "rho_hat = q/69",
      "errorBound": "epsilon_q <= 1/138",
      "class": "CANONICAL_CERTIFIED"
    },
    "uniqueByteDemand": {
      "expression": "U(O)=sum_i u_i*|C_i|",
      "class": "LEEWAY_STORAGE"
    },
    "sourceAcquisition": {
      "expression": "SAF=P_new/L(O)",
      "amplification": "SAFA=L(O)/P_new",
      "class": "LEEWAY_STORAGE"
    },
    "exactStorage": {
      "length": "|O'|=|O|",
      "hash": "SHA256(O')=SHA256(O)",
      "bytes": "O'=O byte-for-byte"
    }
  },
